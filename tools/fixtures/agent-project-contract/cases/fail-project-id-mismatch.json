{
  "id": "fail-project-id-mismatch",
  "description": "A projectId that does not match the repository identity is rejected",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [ { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "projectId": "other-site" } } ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_PROJECT_ID_MISMATCH", "exitCode": 1 } } ]
}
