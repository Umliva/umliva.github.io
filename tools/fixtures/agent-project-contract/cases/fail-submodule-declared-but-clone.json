{
  "id": "fail-submodule-declared-but-clone",
  "description": "A declared submodule path that holds a full clone instead of a gitlink is rejected",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [
        { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "declaredBoundaries": { "submodules": [ { "path": "vendor/lib", "required": false } ] } } },
        { "op": "mkdir", "path": "vendor/lib/.git" },
        { "op": "write", "path": "vendor/lib/.git/config", "content": "[remote \"origin\"]\n\turl = https://github.com/Other/other-site\n" }
      ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_NESTED_PROJECT_ROOT", "exitCode": 1 } } ]
}
