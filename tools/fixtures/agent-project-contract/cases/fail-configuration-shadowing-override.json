{
  "id": "fail-configuration-shadowing-override",
  "description": "A declared shadowing instruction file is rejected",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [ { "op": "write", "path": "AGENTS.override.md", "content": "# Shadowing override\n\nSynthetic shadowing fixture.\n" } ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_CONFIGURATION_SHADOWING", "exitCode": 1 } } ]
}
