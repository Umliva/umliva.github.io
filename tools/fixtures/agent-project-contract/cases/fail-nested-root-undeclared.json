{
  "id": "fail-nested-root-undeclared",
  "description": "An undeclared nested project root is rejected",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [
        { "op": "mkdir", "path": "nested/.git" },
        { "op": "write", "path": "nested/.git/config", "content": "[remote \"origin\"]\n\turl = https://github.com/Other/other-site\n" }
      ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_NESTED_PROJECT_ROOT", "exitCode": 1 } } ]
}
