{
  "id": "ok-declared-submodule",
  "description": "A declared submodule with a .git gitlink and a foreign contract is accepted",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [
        { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "declaredBoundaries": { "submodules": [ { "path": "vendor/lib", "required": false } ] } } },
        { "op": "mkdir", "path": "vendor/lib/config" },
        { "op": "write", "path": "vendor/lib/.git", "content": "gitdir: ../../.git/modules/lib\n" },
        { "op": "copy", "from": "config/agent-project-contract.json", "path": "vendor/lib/config/agent-project-contract.json" },
        { "op": "patchJson", "path": "vendor/lib/config/agent-project-contract.json", "set": { "projectId": "example-library" } }
      ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "OK", "exitCode": 0 } } ]
}
