{
  "id": "fail-contract-schema-missing-field",
  "description": "A required top-level contract field is missing",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [ { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "enforcement": null } } ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_CONTRACT_SCHEMA", "exitCode": 1 } } ]
}
