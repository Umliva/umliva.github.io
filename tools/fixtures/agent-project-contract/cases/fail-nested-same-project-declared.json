{
  "id": "fail-nested-same-project-declared",
  "description": "A second copy of this project inside the root fails even when declared",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [
        { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "declaredBoundaries": { "modulesAllowlist": ["copy"] } } },
        { "op": "mkdir", "path": "copy/config" },
        { "op": "copy", "from": "config/agent-project-contract.json", "path": "copy/config/agent-project-contract.json" }
      ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_NESTED_PROJECT_ROOT", "exitCode": 1 } } ]
}
