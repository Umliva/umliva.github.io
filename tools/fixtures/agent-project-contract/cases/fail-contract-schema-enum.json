{
  "id": "fail-contract-schema-enum",
  "description": "An enforcement classification value outside the enum is rejected",
  "trees": {
    "ROOT": {
      "from": "base",
      "git": { "layout": "primary", "url": "https://github.com/Umliva/umliva.github.io" },
      "setup": [
        { "op": "patchJson", "path": "config/agent-project-contract.json", "set": { "enforcement": { "classification": { "rootIdentity": "ENFORCED_BY_MAGIC" } } } }
      ]
    }
  },
  "steps": [ { "argv": ["--root", "{ROOT}"], "expect": { "reasonCode": "FAIL_CONTRACT_SCHEMA", "exitCode": 1 } } ]
}
