{
  "contractVersion": "1.0.0",
  "contractId": "fixture-agent-project-contract",
  "projectId": "umliva.github.io",
  "projectName": "Synthetic contract fixture",
  "canonicalRemote": {
    "url": "https://github.com/Umliva/umliva.github.io.git",
